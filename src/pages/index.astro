  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // ── 1. METRIC COUNTERS ──
      const pacientesEl = document.getElementById("metric-pacientes");
      const roiEl = document.getElementById("metric-roi");

      if (pacientesEl) {
        const obj1 = { val: 0 };
        anime({
          targets: obj1,
          val: 123,
          round: 1,
          easing: "easeOutExpo",
          duration: 2500,
          update: () => { pacientesEl.textContent = obj1.val; }
        });
      }

      if (roiEl) {
        const obj2 = { val: 0 };
        anime({
          targets: obj2,
          val: 207,
          round: 1,
          easing: "easeOutExpo",
          duration: 2500,
          update: () => { roiEl.textContent = (obj2.val / 10).toFixed(1); }
        });
      }

      // ── 2. SVG LINE DRAW ──
      const line1 = document.getElementById("svg-line-1");
      if (line1) {
        const len = line1.getTotalLength();
        line1.style.strokeDasharray = len;
        line1.style.strokeDashoffset = len;
        anime({
          targets: line1,
          strokeDashoffset: [len, 0],
          easing: "easeInOutSine",
          duration: 2000,
          delay: 400
        });
      }

      // ── 3. DONUT CHART SEGMENTS ──
      document.querySelectorAll(".donut-seg").forEach((seg, i) => {
        const target = parseFloat(seg.getAttribute("data-target")) || 0;
        anime({
          targets: seg,
          strokeDasharray: [0 + " 88", target + " " + (88 - target)],
          easing: "easeOutCubic",
          duration: 1500,
          delay: 600 + i * 200
        });
      });

      // ── 4. FLOATING CARDS ──
      document.querySelectorAll(".anime-float").forEach((el) => {
        const delay = parseInt(el.getAttribute("data-delay") || "0", 10);
        anime({
          targets: el,
          translateY: [-8, 8],
          direction: "alternate",
          loop: true,
          easing: "easeInOutQuad",
          duration: 2400,
          delay: delay
        });
      });
    });
  </script>

